# Copy this file to .env.local and fill in your own values.
# Never commit .env.local and never paste these values into a chat.

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI for the analyst and Morning Report. Groq is used first when set.
# console.groq.com -> API Keys (free tier)
GROQ_API_KEY=
# Optional: Groq model id (default llama-3.3-70b-versatile)
GROQ_MODEL=
# Optional alternative: console.anthropic.com -> API Keys (Claude Haiku)
ANTHROPIC_API_KEY=

# Optional: a Base RPC URL (defaults to the public endpoint)
BASE_RPC_URL=

# Optional: hour of dawn in UTC, when the board locks (default 6)
NEXT_PUBLIC_DAWN_HOUR_UTC=6

# Any long random string. Protects /api/dawn (Vercel cron + manual trigger)
# and /api/demo/analyze.
CRON_SECRET=

# Optional: where "Raise on Vibestarter" links. Hidden when empty.
NEXT_PUBLIC_VIBESTARTER_APPLY_URL=

# Optional: any random string, salts the hashed IPs used for rate limits.
IP_HASH_SALT=

# Development only: an ISO time that replaces the server clock.
# DEV_FAKE_NOW=2026-11-08T06:30:00Z
